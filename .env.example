# Antigravity Mobile Remote Bridge Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Antigravity Local IDE Connection
ANTIGRAVITY_REST_URL=http://127.0.0.1:5000
ANTIGRAVITY_WS_URL=ws://127.0.0.1:9812

# Optional Brain directory override (defaults to ~/.gemini/antigravity-ide/brain)
# BRAIN_DIR=/custom/path/to/brain

# --- MySQL Database (Persistent Users, Devices, Sessions) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=antigravity_db
MYSQL_POOL_LIMIT=10

# --- Redis Cache (High-Speed 90s Ephemeral Pairing & Session Cache) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_URL=redis://default:password@hostname:6379

# --- GitHub OAuth (Optional, defaults to quick dev login if empty) ---
# GITHUB_CLIENT_ID=your_github_oauth_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Environment
NODE_ENV=production

